{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "moduleResolution": "node",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./assets/js/",
        "lib": [
            "ES2023",
            "dom"
        ]
    },
    "include": [
        "assets/ts/*"
    ],
    "exclude": [
        "assets/js/**",
        "assets/ts/type.ts"
    ]
}